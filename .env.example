# ── Ecollab Environment Configuration ──────────────────────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ── Application ──────────────────────────────────────────────────────────────
APP_NAME="Ecollab"
APP_ENV=production          # production | development
APP_URL=https://ecollab.io
APP_DEBUG=false
APP_KEY=GENERATE_WITH_openssl_rand_hex_32

# ── Database ──────────────────────────────────────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=ecollab_v2
DB_USER=ecollab_user
DB_PASS=CHANGE_ME_strong_password
DB_CHARSET=utf8mb4

# ── Session ───────────────────────────────────────────────────────────────────
SESSION_LIFETIME=3600       # seconds (1 hour)
SESSION_SECURE=true         # set false for local HTTP dev
SESSION_SAMESITE=Strict

# ── Security ──────────────────────────────────────────────────────────────────
BCRYPT_COST=12
CSRF_TOKEN_LENGTH=32

# ── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_LOGIN=10         # max attempts per window
RATE_LIMIT_SIGNUP=5
RATE_LIMIT_FORGOT=5
RATE_LIMIT_WINDOW=900       # window in seconds (15 min)

# ── OTP ───────────────────────────────────────────────────────────────────────
OTP_EXPIRY=600              # seconds (10 min)
OTP_LENGTH=6

# ── Mail (for OTP / forgot password) ─────────────────────────────────────────
# Hostinger Mail API (transactional email / OTP)
# MAIL_API_KEY is the token from Email/Agentic Mail -> API access.
# MAILBOX_RESOURCE_ID is the AC... resource ID returned by GET /api/v1/me.
MAIL_API_URL=https://api.mail.hostinger.com
MAIL_API_KEY=your_hostinger_mail_api_token
MAILBOX_RESOURCE_ID=ACxxxxxxxxxxxxxxxx
MAIL_FROM=noreply@ecollab.io
MAIL_FROM_NAME="Ecollab"

# ── Institution ───────────────────────────────────────────────────────────────
DEFAULT_INSTITUTION_DOMAIN=fatima.edu.ph

# ── WebSocket ─────────────────────────────────────────────────────────────────
WS_HOST=0.0.0.0
WS_PORT=8080
WS_URL=ws://localhost:8080

# ── OAuth / SSO ───────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost/ecollab_sample5/ecollab-fixed/API/auth/oauth-callback.php?provider=google

MICROSOFT_CLIENT_ID=your_microsoft_client_id
MICROSOFT_CLIENT_SECRET=your_microsoft_client_secret
MICROSOFT_TENANT_ID=common
MICROSOFT_REDIRECT_URI=http://localhost/ecollab_sample5/ecollab-fixed/API/auth/oauth-callback.php?provider=microsoft

# ── AI / Anthropic (used by API/chat/ai-assist.php) ───────────────────────────
# Get a key from: https://console.anthropic.com/settings/keys
# Leave as the placeholder below to keep the AI-assist feature disabled.
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
