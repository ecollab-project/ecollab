# ── Ecollab Environment Configuration ──────────────────────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ── Application ──────────────────────────────────────────────────────────────
APP_NAME="Ecollab"
APP_ENV=production
APP_URL=https://ecollab.io
APP_DEBUG=false
APP_KEY=GENERATE_WITH_openssl_rand_hex_32

# ── Database ──────────────────────────────────────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=ecollab_v2
DB_USER=ecollab_user
DB_PASS=CHANGE_ME_strong_password
DB_CHARSET=utf8mb4

# ── Session ───────────────────────────────────────────────────────────────────
SESSION_LIFETIME=3600
SESSION_SECURE=true
SESSION_SAMESITE=Strict

# ── Security ──────────────────────────────────────────────────────────────────
BCRYPT_COST=12
CSRF_TOKEN_LENGTH=32

# ── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_LOGIN=10
RATE_LIMIT_SIGNUP=5
RATE_LIMIT_FORGOT=5
RATE_LIMIT_WINDOW=900

# ── OTP ───────────────────────────────────────────────────────────────────────
OTP_EXPIRY=600
OTP_LENGTH=6

# ── Mail (Brevo transactional email / OTP) ────────────────────────────────────
# Never commit BREVO_API_KEY. Create it in Brevo Settings -> SMTP & API -> API Keys.
BREVO_API_URL=https://api.brevo.com
BREVO_API_KEY=your_brevo_api_v3_key
BREVO_SENDER_EMAIL=your_verified_sender@example.com
BREVO_SENDER_NAME="Ecollab"

# ── Institution ───────────────────────────────────────────────────────────────
DEFAULT_INSTITUTION_DOMAIN=fatima.edu.ph

# ── WebSocket ──────────────────────────────────────────────────────────────────
WS_HOST=0.0.0.0
WS_PORT=8080
WS_URL=ws://localhost:8080

# ── OAuth / SSO ───────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost/ecollab_sample5/ecollab-fixed/API/auth/oauth-callback.php?provider=google

MICROSOFT_CLIENT_ID=your_microsoft_client_id
MICROSOFT_CLIENT_SECRET=your_microsoft_client_secret
MICROSOFT_TENANT_ID=common
MICROSOFT_REDIRECT_URI=http://localhost/ecollab_sample5/ecollab-fixed/API/auth/oauth-callback.php?provider=microsoft

# ── AI / Google Gemini ────────────────────────────────────────────────────────
# Keep the real key only in the untracked .env file.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-flash-latest
