cute","captured":true}],"bindings_replayable":true,"ms":0.127022,"success":true,"error":null},{"sql":"SELECT m.id,m.content,m.created_at,c.name AS channel_name,s.name AS server_name\n                FROM (SELECT id,created_at FROM messages ORDER BY created_at DESC LIMIT 256) recent\n                JOIN messages m ON m.id=recent.id JOIN channels c ON c.id=m.channel_id\n                JOIN servers s ON s.id=c.server_id\n                JOIN server_members sm ON sm.server_id=s.id AND sm.user_id=:uid\n                WHERE m.is_deleted=0 AND CASE WHEN EXISTS(\n                    SELECT 1 FROM server_members WHERE user_id=:membership_uid LIMIT 1\n                ) THEN EXISTS(\n                    SELECT 1 FROM messages gate FORCE INDEX (PRIMARY) JOIN channels gc ON gc.id=gate.channel_id\n                    JOIN server_members gsm ON gsm.server_id=gc.server_id AND gsm.user_id=:gate_uid\n                    WHERE gate.is_deleted=0 LIMIT 1) ELSE 0 END\n                ORDER BY recent.created_at DESC LIMIT 9","operation":"execute","params":{":uid":1,":gate_uid":1,":membership_uid":1},"bindings":[{"parameter":":uid","value":1,"pdo_type":2,"source":"execute","captured":true},{"parameter":":gate_uid","value":1,"pdo_type":2,"source":"execute","captured":true},{"parameter":":membership_uid","value":1,"pdo_type":2,"source":"execute","captured":true}],"bindings_replayable":true,"ms":0.150007,"success":true,"error":null},{"sql":"SELECT m.id,m.content,m.created_at,c.name AS channel_name,s.name AS server_name\n            FROM messages m JOIN channels c ON c.id=m.channel_id JOIN servers s ON s.id=c.server_id\n            JOIN server_members sm ON sm.server_id=s.id AND sm.user_id=:uid\n            WHERE m.is_deleted=0 ORDER BY m.created_at DESC LIMIT 8","operation":"execute","params":{":uid":1},"bindings":[{"parameter":":uid","value":1,"pdo_type":2,"source":"execute","captured":true}],"bindings_replayable":true,"ms":0.290148,"success":true,"error":null},{"sql":"\n                S