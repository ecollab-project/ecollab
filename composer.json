{
  "name": "ecollab/platform",
  "description": "Ecollab — unified auth + chat platform",
  "type": "project",
  "require": {
    "php": ">=8.1",
    "cboden/ratchet": "^0.4",
    "react/event-loop": "^1.3"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5",
    "phpstan/phpstan": "^1.11"
  },
  "autoload": {
    "files": [
      "config.php",
      "database/config/db.php",
      "security/csrf/csrf.php",
      "security/middleware/AuthMiddleware.php",
      "security/middleware/RoleMiddleware.php",
      "security/rate-limit/RateLimiter.php",
      "security/forgot-password/OtpService.php",
      "services/AuthService.php",
      "services/OAuthService.php",
      "services/ChannelService.php",
      "services/MessageService.php",
      "services/WhiteboardService.php",
      "services/UserService.php",
      "websocket/ChatServer.php",
      "websocket/handlers/MessageHandler.php",
      "websocket/handlers/PresenceHandler.php",
      "websocket/handlers/TypingHandler.php",
      "services/AiSessionService.php"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "config": {
    "optimize-autoloader": true
  }
}