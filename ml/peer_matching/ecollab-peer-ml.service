[Unit]
Description=eCollab local semantic peer matching
After=network.target

[Service]
Type=simple
User=ecollabadmin
WorkingDirectory=/home/ecollabadmin/ecollab-inspect/ml/peer_matching
EnvironmentFile=/etc/ecollab-peer-ml.env
Environment=OMP_NUM_THREADS=1
Environment=TOKENIZERS_PARALLELISM=false
ExecStart=/home/ecollabadmin/ecollab-inspect/ml/peer_matching/.venv/bin/python server.py
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=true
MemoryMax=1500M
CPUQuota=100%

[Install]
WantedBy=multi-user.target
