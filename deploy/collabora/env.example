# Docker Compose environment (deploy/collabora/.env)
COLLABORA_IMAGE=collabora/code@sha256:REPLACE_WITH_VERIFIED_IMAGE_DIGEST
ECOLLAB_ORIGIN=https://ecollab.tech:443
COLLABORA_HOST=office.ecollab.tech

# Add the following to eCollab's root .env, not the Docker environment:
# DOCUMENT_EDITOR=collabora
# COLLABORA_URL=https://office.ecollab.tech
# COLLABORA_WOPI_URL=https://ecollab.tech
# DOCUMENT_AI_ENABLED=false
# DOCUMENT_ML_ENABLED=false
# Existing OLLAMA_URL/OLLAMA_MODEL serve Jarred; existing PEER_ML_* serve related titles.
