# Append these settings to the application's existing .env. Do not replace it.
# Judge0 must run on an isolated worker; its endpoint is never called by the browser.
CODE_LAB_JUDGE0_URL=http://127.0.0.1:2358
CODE_LAB_JUDGE0_TOKEN=
# REQUIRED: map IDs from your runner's /languages list, not guessed compiler versions.
# Example syntax only. Replace each ID with your selected installed version:
CODE_LAB_LANGUAGE_IDS={"c":50,"cpp":54,"python":71,"java":62,"javascript":63}
