# Application-side configuration only. Never copy the application .env to runner.
CODE_LAB_RUNNER_TRANSPORT=mtls
CODE_LAB_JUDGE0_URL=https://runner.execution.internal:2443
CODE_LAB_JUDGE0_TOKEN=REPLACE_WITH_EXISTING_PRIVATE_ADAPTER_TOKEN_AT_LEAST_32_CHARACTERS
CODE_LAB_RUNNER_TLS_CA=/etc/ecollab-runner-client/server-ca.crt
CODE_LAB_RUNNER_TLS_CERT=/etc/ecollab-runner-client/client.crt
CODE_LAB_RUNNER_TLS_KEY=/etc/ecollab-runner-client/client.key
# Preserve the actual frozen IDs, including legacy Java; do not regenerate here.
# CODE_LAB_LANGUAGE_IDS=<existing mapping>
# Preserve the existing worker-slot configuration; this file does not tune it.
