# STAGING ONLY: native gateway on the isolated execution VM, outside containers.
# Replace __PRIVATE_ADDRESS__, __TLS_DIRECTORY__ and __ADAPTER_ADDRESS__.
# The private listener must also be protected by an independently enforced ACL.
# No database/application/admin keys belong on this machine.
limit_conn_zone $binary_remote_addr zone=runner_clients:1m;
server {
    listen __PRIVATE_ADDRESS__ ssl;
    server_name _;
    ssl_certificate __TLS_DIRECTORY__/server.crt;
    ssl_certificate_key __TLS_DIRECTORY__/server.key;
    ssl_client_certificate __TLS_DIRECTORY__/client-ca.crt;
    ssl_crl __TLS_DIRECTORY__/client-ca.crl;
    ssl_verify_client on;
    ssl_verify_depth 1;
    ssl_protocols TLSv1.2 TLSv1.3;
    # Recheck peer credentials on each TLS connection, including after CRL change.
    ssl_session_cache off;
    ssl_session_tickets off;
    limit_conn runner_clients 16;
    client_max_body_size 256k;
    client_body_buffer_size 256k;
    client_body_timeout 5s;
    # Never log source, case inputs, bearer credentials or opaque result tokens.
    access_log off;
    error_log /dev/null;
    location ~ "^/(?:languages|submissions(?:/[A-Za-z0-9-]{8,100})?|grade-submissions)$" {
        limit_except GET POST { deny all; }
        proxy_pass http://__ADAPTER_ADDRESS__;
        proxy_set_header X-Auth-Token $http_x_auth_token;
        proxy_set_header Connection close;
        proxy_connect_timeout 2s;
        proxy_send_timeout 5s;
        proxy_read_timeout 15s;
        proxy_buffering off;
        proxy_next_upstream off;
    }
    location / { return 404; }
}
