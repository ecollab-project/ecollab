# Execution-host configuration only; no application .env or DB/admin secrets.
# Replace placeholders after checking routes and provider/overlay address ranges.
# Requires Compose2.24.4+ with !reset; both adapter and Piston remain unpublished.
CODE_LAB_EXECUTION_SUBNET=REPLACE_WITH_UNUSED_PRIVATE_SUBNET
CODE_LAB_ADAPTER_IPV4=REPLACE_WITH_PRIVATE_ADDRESS_IN_THAT_SUBNET
CODE_LAB_RUNNER_STATE=/var/lib/ecollab-code-lab
# CODE_LAB_EXECUTION_SLOTS=<preserve existing setting>
# Native Nginx __ADAPTER_ADDRESS__ must equal CODE_LAB_ADAPTER_IPV4:2358.
