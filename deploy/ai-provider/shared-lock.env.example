# STAGING ONLY. Same pre-provisioned regular file/inode visible to EVERY caller.
# Preserve this variable in both PHP-FPM pool and CLI worker environments.
# FPM clear_env/PrivateTmp and container mounts must be inspected, not assumed.
OLLAMA_INFERENCE_LOCK_FILE=/run/ecollab-ai/ollama-inference.lock
# Existing endpoint/model/thread/worker-count settings remain unchanged.
