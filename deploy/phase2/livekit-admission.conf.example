# STAGING TEMPLATE ONLY. Include in a dedicated LiveKit HTTPS server block.
# Requires nginx http_auth_request_module; replace application path/FPM socket.
# LiveKit HTTP/signaling origin 7880 must be private; media/TURN ports are separate.
# Do not add a catch-all proxy, alternate signaling listener or auth fail-open fallback.
location = /_ecollab_media_admission {
    internal;
    access_log off;
    error_log /dev/null;
    include fastcgi_params;
    fastcgi_param SCRIPT_FILENAME /var/www/ecollab/API/internal/livekit-admission.php;
    fastcgi_param ECOLLAB_INTERNAL_MEDIA_ADMISSION 1;
    fastcgi_param ECOLLAB_MEDIA_QUERY $ecollab_media_original_query;
    fastcgi_param HTTP_AUTHORIZATION $http_authorization;
    fastcgi_param CONTENT_LENGTH "";
    fastcgi_pass_request_body off;
    fastcgi_connect_timeout 1s;
    fastcgi_read_timeout 3s;
    fastcgi_pass unix:/run/php/php8.3-fpm.sock;
}

# Both generations of join/reconnect and validation use the same gate.
location ~ ^/rtc(?:/v1)?(?:/validate)?$ {
    # Query strings contain credentials. Do not inherit request-URI access logging.
    access_log off;
    # Nginx error context can include credential-bearing request URIs.
    # Collect sanitized status/latency metrics at ingress; never log raw arguments.
    error_log /dev/null;
    if ($request_method = OPTIONS) {
        add_header Access-Control-Allow-Origin "https://ecollab.tech" always;
        add_header Access-Control-Allow-Methods "GET, OPTIONS" always;
        add_header Access-Control-Allow-Headers "Authorization" always;
        return 204;
    }
    set $ecollab_media_original_query $args;
    auth_request /_ecollab_media_admission;
    proxy_pass http://127.0.0.1:7880;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
    proxy_set_header Authorization $http_authorization;
    proxy_buffering off;
    proxy_read_timeout 65s;
}

# Server-only JWT grants are still checked by LiveKit's RoomService.
# Required by room creation, count collector and participant revocation worker.
location ~ ^/twirp/livekit[.]RoomService/[A-Za-z]+$ {
    access_log off;
    proxy_pass http://127.0.0.1:7880;
    proxy_set_header Authorization $http_authorization;
}
location / { return 404; }
