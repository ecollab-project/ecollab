# Copy to .env on the VPS. Never commit the real file.
APP_NAME="Ecollab"
APP_ENV=production
APP_URL=http://YOUR_VPS_IP
APP_DEBUG=false
APP_KEY=GENERATE_WITH_openssl_rand_hex_32

DB_HOST=db
DB_PORT=3306
DB_NAME=ecollab_v2
DB_USER=ecollab_user
DB_PASS=CHANGE_ME_STRONG_PASSWORD
DB_ROOT_PASS=CHANGE_ME_ANOTHER_STRONG_PASSWORD
DB_CHARSET=utf8mb4

SESSION_LIFETIME=3600
SESSION_SECURE=false
SESSION_SAMESITE=Strict

BCRYPT_COST=12
CSRF_TOKEN_LENGTH=32
RATE_LIMIT_LOGIN=10
RATE_LIMIT_SIGNUP=5
RATE_LIMIT_FORGOT=5
RATE_LIMIT_WINDOW=900
OTP_EXPIRY=600
OTP_LENGTH=6

MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USER=CHANGE_ME
MAIL_PASS=CHANGE_ME
MAIL_FROM=noreply@example.com
MAIL_FROM_NAME="Ecollab"

DEFAULT_INSTITUTION_DOMAIN=fatima.edu.ph

WS_HOST=0.0.0.0
WS_PORT=8080
WS_URL=ws://YOUR_VPS_IP:8080

GOOGLE_CLIENT_ID=CHANGE_ME
GOOGLE_CLIENT_SECRET=CHANGE_ME
GOOGLE_REDIRECT_URI=http://YOUR_VPS_IP/API/auth/oauth-callback.php?provider=google

MICROSOFT_CLIENT_ID=CHANGE_ME
MICROSOFT_CLIENT_SECRET=CHANGE_ME
MICROSOFT_TENANT_ID=common
MICROSOFT_REDIRECT_URI=http://YOUR_VPS_IP/API/auth/oauth-callback.php?provider=microsoft

ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
