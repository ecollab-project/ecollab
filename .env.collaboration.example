# Optional external collaboration engines for eCollab.
# Leave blank to keep the native eCollab collaboration tools only.
# Never put API keys or JWT secrets in source control.

# Etherpad instance, e.g. http://localhost:9001
ETHERPAD_URL=

# Excalidraw-compatible deployment URL.
# NOTE: the official Excalidraw self-hosted client currently does not provide
# sharing/collaboration by itself; configure a collaboration-capable deployment
# before enabling this in production.
EXCALIDRAW_URL=

# ONLYOFFICE Docs Document Server URL used by the browser/eCollab.
# Your Docker Desktop ONLYOFFICE server is exposed on port 8088.
ONLYOFFICE_DOCUMENT_SERVER_URL=http://localhost:8088

# Must match the JWT secret configured in ONLYOFFICE Docs.
# Keep this value only in the real local .env file; never commit it.
ONLYOFFICE_JWT_SECRET=

# URL that the ONLYOFFICE server/container uses to reach eCollab.
# With XAMPP + Docker Desktop, localhost inside the ONLYOFFICE container
# refers to the container itself, so use host.docker.internal for the host.
# Browser-side URLs can still use http://localhost/ecollab.
ONLYOFFICE_STORAGE_BASE_URL=http://host.docker.internal/ecollab

# Legacy setting kept for compatibility with the first collaboration-hub draft.
# It is no longer used as a raw iframe/editor URL.
ONLYOFFICE_EDITOR_URL=
